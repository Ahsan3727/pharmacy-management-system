{
  "buildCommand": "pnpm install --allow-build=esbuild && pnpm --filter=@hs-pharma/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install --allow-build=esbuild",
  "functions": {
    "apps/api/api/index.ts": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/apps/api/api/index.ts"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
