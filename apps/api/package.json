{
  "name": "@hs-pharma/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "vercel-build": "echo 'no build needed for serverless'",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "seed:owner": "tsx --env-file=../../.env src/scripts/seedOwner.ts"
  },
  "dependencies": {
    "@hs-pharma/shared": "workspace:*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "migrate-mongo": "^11.0.0",
    "mongoose": "^8.5.2",
    "node-cron": "^3.0.3",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.4.0",
    "@types/node-cron": "^3.0.11",
    "supertest": "^7.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
